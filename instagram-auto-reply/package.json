{
  "name": "instagram-auto-reply",
  "version": "1.0.0",
  "private": true,
  "description": "Responde comentários nos seus posts do Instagram pela interface web, usando Playwright.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test test/account-config.test.js test/pair-supervisor.test.js test/post-retry.test.js test/reply-read.test.js test/thread-exclusions.test.js test/mobile-fallback.test.js test/comment-open.test.js test/collaboration.test.js test/session-transfer.test.js test/service-restart.test.js test/message-bank.test.js test/post-safety.test.js test/guard-monitor.test.js",
    "test:messages": "node --test test/message-bank.test.js",
    "test:post-safety": "node --test test/post-safety.test.js",
    "test:run-window": "node --test test/run-window.test.js",
    "messages:prepare": "node src/prepare-messages.js",
    "test:pair": "node --test test/pair-supervisor.test.js",
    "test:retry": "node --test test/post-retry.test.js",
    "test:threads": "node --test test/thread-exclusions.test.js",
    "setup": "playwright install chromium",
    "login": "node src/login.js",
    "browser": "node src/open-instagram.js",
    "browser:test": "node src/manual-browser-test.js",
    "browser:account2": "node src/open-instagram.js --instance tntsportsbr-1 --secondary-account",
    "browser:account2:iphone": "node src/open-instagram.js --instance tntsportsbr-1 --secondary-account --browser-mode iphone",
    "login:account2": "node src/login.js --instance tntsportsbr-1 --secondary-account",
    "browser:account3": "node src/open-instagram.js --instance tntsportsbr-1 --third-account",
    "login:account3": "node src/login.js --instance tntsportsbr-1 --third-account",
    "login:correa": "node src/login.js --instance tntsportsbr-1 --fourth-account --browser-mode desktop",
    "watch:2:correa": "node src/service.js --two --fourth-account --shared-history --sync-browser-modes --mobile-fallback --browser-mode desktop --no-action-delays",
    "watch:2:gabriel-correa": "node src/service.js --gabriel-correa-failover --shared-history --mobile-fallback --browser-mode desktop --no-action-delays",
    "watch:2:accounts": "node src/watch-all.js --account-failover --no-action-delays",
    "watch:2:galo-first": "node src/watch-all.js --account-mode-failover --mobile-fallback --browser-mode desktop --no-action-delays",
    "watch:2:account2": "node src/watch-all.js --two --secondary-account --shared-history --prepare-account --no-action-delays --mobile-fallback --sync-browser-modes",
    "watch:2:account3": "node src/watch-all.js --two --third-account --shared-history --prepare-account --no-action-delays --mobile-fallback --sync-browser-modes",
    "watch:2:gabriel": "node src/service.js --two --shared-history --mobile-fallback --sync-browser-modes --browser-mode desktop",
    "watch:2:gbrdastip": "node src/start-gbrdastip.js",
    "watch:2:gbrdastips": "node src/start-gbrdastip.js --username gbrdastips --login-profile gabrieldastips",
    "watch:2:gbrdastips": "node src/start-gbrdastips.js",
    "watch:2:galo-caze": "node src/watch-all.js --caze-only --secondary-account --shared-history --no-action-delays --mobile-fallback --sync-browser-modes",
    "watch:2:accounts:split": "node src/service.js --two-accounts --shared-history --sync-browser-modes --instance-account-failover --mobile-fallback --browser-mode desktop --no-action-delays",
    "start": "node src/index.js",
    "dry": "node src/index.js --dry-run",
    "watch": "node src/index.js --watch",
    "watch:all": "node src/watch-all.js",
    "watch:4:test": "node src/watch-all.js --no-action-delays",
    "watch:3": "node src/watch-all.js --three",
    "watch:2": "node src/watch-all.js --two",
    "watch:2:test": "node src/watch-all.js --two --no-action-delays",
    "watch:2:fast": "node src/watch-all.js --two --fast-navigation",
    "watch:3:fast": "node src/watch-all.js --three --fast-navigation",
    "browser:caze1": "node src/open-instagram.js --instance cazetv-1",
    "browser:caze2": "node src/open-instagram.js --instance cazetv-2",
    "browser:tnt1": "node src/open-instagram.js --instance tntsportsbr-1",
    "browser:tnt2": "node src/open-instagram.js --instance tntsportsbr-2",
    "watch:caze1": "node src/index.js --watch --instance cazetv-1",
    "watch:caze2": "node src/index.js --watch --instance cazetv-2",
    "watch:tnt1": "node src/index.js --watch --instance tntsportsbr-1",
    "watch:tnt2": "node src/index.js --watch --instance tntsportsbr-2",
    "watch:reserve": "node src/index.js --watch --reserve",
    "login:reserve": "node src/login.js --reserve",
    "report": "node src/report.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "playwright": "^1.48.0"
  }
}
