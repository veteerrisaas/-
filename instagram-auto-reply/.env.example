# Seu usuário do Instagram (sem @)
IG_USERNAME=seu_usuario
IG_SECOND_USERNAME=usuario_da_segunda_conta
# Opcional: terceira conta da troca automatica
IG_THIRD_USERNAME=

# true = só mostra no log o que responderia, sem enviar nada
DRY_RUN=true

# false = navegador visível (padrão recomendado)
HEADLESS=false
